                "exec": [
                  "pm.test('NEG-03: Discount with INR currency rejected with 400 or 422', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});",
                  "pm.test('NEG-03: Error body rejects non-KES currency on discounts endpoint', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.any.keys('error', 'message', 'detail');",
                  "});"
                ],
                "type": "text/javascript"
