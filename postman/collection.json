              "mode": "raw",
              "raw": "{\n  \"driver_id\": \"{{driver_id}}\",\n  \"discount_amount\": 500,\n  \"currency\": \"INR\",\n  \"reason\": \"promo\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/billing/discounts",
              "host": ["{{base_url}}"],
              "path": ["billing", "discounts"]
            }
          }
        },
        {
          "name": "NEG-04: POST /billing/cycles - Boundary Invalid Week Number (week 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('NEG-04: Invalid boundary week_number (0) rejected with 400 or 422', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});",
                  "pm.test('NEG-04: Error response references week_number boundary', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.any.keys('error', 'message', 'detail');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_id\": \"{{driver_id}}\",\n  \"week_number\": 0,\n  \"currency\": \"KES\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/billing/cycles",
              "host": ["{{base_url}}"],
              "path": ["billing", "cycles"]
            }
          }
        },
        {
          "name": "NEG-05: POST /billing/payments - Reject Negative Payment Amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('NEG-05: Negative payment amount rejected with 400 or 422', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
